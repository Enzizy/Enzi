{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enzi",
  "version": "1.0.4",
  "identifier": "com.enzi.notch",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "index.html",
        "title": "Enzi",
        "width": 640,
        "height": 360,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBRUZCRkEwNzlBNDEzQzgKUldUSUU2UjVvTC92R2lFb1Q3S01Jb1F0ZWNUMWg3N1lURWRTa1p6azlidjB3eGxKejNPWG90T0EK",
      "endpoints": ["https://github.com/Enzizy/Enzi/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
